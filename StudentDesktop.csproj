<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Compile Remove="StudentDesktop.Tests\**" />
    <AvaloniaResource Remove="StudentDesktop.Tests\**" />
    <None Remove="StudentDesktop.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="StudentDesktop.Tests/**" />
    <Content Remove="StudentDesktop.Tests/**" />
    <EmbeddedResource Remove="StudentDesktop.Tests/**" />
    <None Remove="StudentDesktop.Tests/**" />
    <AvaloniaResource Remove="StudentDesktop.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- SDA-03/SDA-08: platform-native WebView (WebView2/WKWebView/WPE WebKit) for the
         whitelisted browser. MIT-licensed, official AvaloniaUI package — not the paid
         Avalonia Accelerate product. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <!-- Work Item C (SDA/SEK plan): local encrypted scratch store, see LocalStoreContext.
         Microsoft.Data.Sqlite transitively pulls SQLitePCLRaw.bundle_e_sqlite3 (the plain,
         unencrypted provider) alongside bundle_e_sqlcipher's encrypted one — NU1903 flags
         its SQLitePCLRaw.lib.e_sqlite3 2.1.11 for CVE-2025-6965 (a >=3.50.2 SQLite fix,
         first_patched_version null for this package at time of writing; the newer 3.x
         SQLitePCLRaw.lib.e_sqlite3 releases aren't paired with a compatible e_sqlcipher
         release yet, so pinning past 2.1.11 here isn't safely possible today). Real-world
         exposure is bounded: LocalStoreContext.OpenAsync explicitly calls
         raw.SetProvider(new SQLite3Provider_e_sqlcipher()) before opening any connection,
         so this plain e_sqlite3 provider is never the one actually used to parse SQL in
         this app — but it does still ship in the output, so revisit this pin once a patched
         e_sqlcipher release exists upstream. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <!-- See the SQLitePCLRaw.bundle_e_sqlcipher comment above: GHSA-2m69-gcr7-jv3q has no
       first_patched_version for SQLitePCLRaw.lib.e_sqlite3 yet, and the app never actually
       uses that plain provider to parse SQL (raw.SetProvider always selects e_sqlcipher).
       Suppressed here (rather than left to fail CI's "Check for vulnerable NuGet packages"
       step) so that step still catches any *other*, newly-introduced advisory instead of
       being permanently red on this already-accepted, currently-unfixable one. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!-- SDA-19: SEK-03's NotesEditor is React/TypeScript; embedding it means loading a
       standalone bundle in a NativeWebView, not referencing a .NET assembly. Since the
       repo split, campus-shared-editor-kit is a git submodule (external/shared-editor-kit)
       pinned to the host-0.7.0 tag. Initialize the submodule, then run
       `npm run build:host` inside it before dotnet build. Not yet wired into a
       cross-toolchain CI/build step (tracked as a follow-up, same as pre-split), so this
       is a manual dev prerequisite for now. Missing dist/host just yields zero copied
       files, not a build error, since Content globs don't fail on no matches. -->
  <ItemGroup>
    <Content Include="external\shared-editor-kit\dist\host\**">
      <Link>SekHost\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- SEK-01: the Coding app's WebView host bundle, built alongside the notes host by the
       same `npm run build:host` (see scripts/build-host.mjs in shared-editor-kit) — same
       manual dev prerequisite as SekHost above. -->
  <ItemGroup>
    <Content Include="external\shared-editor-kit\dist\host-code\**">
      <Link>CodeHost\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- SDA-24: DMS-01's MessageInbox/MessageThreadView are React/TypeScript, same
       embedding approach as SDA-19's SEK integration above. campus-direct-messaging is a
       git submodule (external/direct-messaging) pinned to the host-0.1.0 tag. Initialize
       the submodule, then run `npm run build:host` inside it before dotnet build. -->
  <ItemGroup>
    <Content Include="external\direct-messaging\dist\host\**">
      <Link>DmsHost\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
