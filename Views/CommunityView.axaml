<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudentDesktop.ViewModels"
             xmlns:models="using:StudentDesktop.Models"
             xmlns:avconv="using:Avalonia.Data.Converters"
             xmlns:conv="using:StudentDesktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="StudentDesktop.Views.CommunityView"
             x:DataType="vm:CommunityViewModel">

    <UserControl.Styles>
        <!-- Flat, left-aligned row button for the My Clubs / My Classroom Discussions
             sidebar lists — selection here is command-driven (SelectClubCommand/
             SelectClassroomDiscussionCommand), not a ListBox.SelectedItem binding, so this
             just needs to look like a plain list row rather than a default button. -->
        <Style Selector="Button.community-list-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.community-list-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemRailBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,12" Spacing="8">
            <TextBlock Text="Community" FontSize="20" FontWeight="Bold"/>
            <Border Classes="banner-error" IsVisible="{Binding ErrorMessage, Converter={x:Static avconv:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"/>
            </Border>
        </StackPanel>

        <Border DockPanel.Dock="Left" Width="240" BorderBrush="{DynamicResource SystemBorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Spacing="4">
                    <TextBlock Text="My Clubs" FontWeight="Bold" Margin="10,10,10,2"/>
                    <TextBlock Text="No clubs joined yet." Classes="empty-state" Margin="10,0"
                               IsVisible="{Binding MyClubs.Count, Converter={x:Static conv:CountToIsEmptyConverter.Instance}}"/>
                    <ItemsControl ItemsSource="{Binding MyClubs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ClubDto">
                                <Button Classes="community-list-item" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[UserControl].((vm:CommunityViewModel)DataContext).SelectClubCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="Club" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource SystemBorderBrush}" BorderThickness="0,1,0,0" Margin="10,8"/>

                    <TextBlock Text="My Classroom Discussions" FontWeight="Bold" Margin="10,2"/>
                    <TextBlock Text="No classroom discussions yet." Classes="empty-state" Margin="10,0"
                               IsVisible="{Binding MyClassroomDiscussions.Count, Converter={x:Static conv:CountToIsEmptyConverter.Instance}}"/>
                    <ItemsControl ItemsSource="{Binding MyClassroomDiscussions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ClassroomDiscussionDto">
                                <Button Classes="community-list-item" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[UserControl].((vm:CommunityViewModel)DataContext).SelectClassroomDiscussionCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SectionName}" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SubjectName}" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid>
            <TextBlock Text="Select a club or classroom discussion to see its posts and materials." Classes="empty-state"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300">
                <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="SelectedClub" Converter="{x:Static avconv:ObjectConverters.IsNull}"/>
                        <Binding Path="SelectedClassroomDiscussion" Converter="{x:Static avconv:ObjectConverters.IsNull}"/>
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>

            <ScrollViewer>
                <ScrollViewer.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="SelectedClub" Converter="{x:Static avconv:ObjectConverters.IsNotNull}"/>
                        <Binding Path="SelectedClassroomDiscussion" Converter="{x:Static avconv:ObjectConverters.IsNotNull}"/>
                    </MultiBinding>
                </ScrollViewer.IsVisible>
                <StackPanel Margin="16" Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Materials" FontWeight="Bold"/>
                        <TextBlock Text="No materials yet." Classes="empty-state"
                                   IsVisible="{Binding Materials.Count, Converter={x:Static conv:CountToIsEmptyConverter.Instance}}"/>
                        <ItemsControl ItemsSource="{Binding Materials}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:MaterialDto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2" ToolTip.Tip="{Binding FileUrl}">
                                        <TextBlock Text="📎"/>
                                        <TextBlock Text="{Binding Title}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Posts" FontWeight="Bold"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding NewPostContent}" PlaceholderText="Post something…" AcceptsReturn="True"/>
                            <Button Grid.Column="1" Content="Post" Command="{Binding PostCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="No posts yet — be the first." Classes="empty-state"
                                   IsVisible="{Binding Posts.Count, Converter={x:Static conv:CountToIsEmptyConverter.Instance}}"/>
                        <ItemsControl ItemsSource="{Binding Posts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CommunityPostItem">
                                    <Border BorderBrush="{DynamicResource SystemBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, h:mm tt}'}" FontSize="11" Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>

</UserControl>
