<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudentDesktop.ViewModels"
             xmlns:conv="using:StudentDesktop.Converters"
             xmlns:avconv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="StudentDesktop.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="16">
            <TextBlock Text="My Calendar" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="College-wide events, registered events, to-dos, and custom entries in one view — class schedule overlaid Google-Calendar-style."
                       TextWrapping="Wrap" Foreground="Gray"/>

            <ProgressBar Classes="busy-spinner" IsVisible="{Binding IsBusy}"/>
            <Border Classes="banner-error" IsVisible="{Binding ErrorMessage, Converter={x:Static avconv:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"/>
            </Border>

            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0" Content="&lt; Previous" Command="{Binding PreviousWeekCommand}"/>
                <Button Grid.Column="1" Content="Today" Margin="8,0,0,0" Command="{Binding GoToTodayCommand}" IsEnabled="{Binding !IsCurrentWeek}"/>
                <Button Grid.Column="2" Content="Next &gt;" Margin="8,0,0,0" Command="{Binding NextWeekCommand}"/>
                <TextBlock Grid.Column="4" Text="{Binding WeekRangeLabel}" FontWeight="Medium" VerticalAlignment="Center"/>
            </Grid>
            <Border Classes="banner-warning" IsVisible="{Binding !IsCurrentWeek}">
                <TextBlock Text="Class sessions are only shown for the current week. Select &quot;Today&quot; to see this week's schedule."/>
            </Border>

            <Border BorderBrush="{DynamicResource SystemBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding GridCells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid ColumnDefinitions="60,*,*,*,*,*,*,*"
                                  RowDefinitions="30,46,46,46,46,46,46,46,46,46,46,46,46,46,46"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="vm:CalendarCellViewModel">
                            <Setter Property="Grid.Row" Value="{Binding Row}"/>
                            <Setter Property="Grid.Column" Value="{Binding Column}"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:CalendarCellViewModel">
                            <Border Background="{Binding Kind, Converter={x:Static conv:KindToBrushConverter.Instance}}"
                                    BorderBrush="#EEEEEE" BorderThickness="0,0,1,1" Padding="3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" FontWeight="Bold" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SubText}" FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="To-dos" FontWeight="Bold" FontSize="14"/>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto" >
                <TextBox Grid.Column="0" Text="{Binding NewTodoTitle}" PlaceholderText="Add a to-do…"/>
                <CalendarDatePicker Grid.Column="1" Margin="8,0,0,0" Width="150"
                                     SelectedDate="{Binding NewTodoDueDate}" PlaceholderText="Due date (optional)"/>
                <ComboBox Grid.Column="2" Margin="8,0,0,0" Width="110" SelectedIndex="{Binding NewTodoPriority}">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="Low"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="High"/>
                </ComboBox>
                <Button Grid.Column="3" Content="Add" Margin="8,0,0,0" Command="{Binding AddTodoCommand}"/>
            </Grid>
            <TextBlock Text="No to-dos yet." Classes="empty-state" IsVisible="{Binding Todos.Count, Converter={x:Static conv:CountToIsEmptyConverter.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Todos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TodoItemViewModel">
                        <Border Classes="card" Classes.overdue="{Binding IsOverdue}" Margin="0,0,0,4">
                            <Grid ColumnDefinitions="4,Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                <Rectangle Grid.Column="0" Grid.RowSpan="2" Width="4"
                                           Fill="{Binding Priority, Converter={x:Static conv:PriorityToBrushConverter.Instance}}"
                                           Margin="-12,-12,8,-12"/>

                                <!-- Display mode -->
                                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding IsCompleted}" IsVisible="{Binding !IsEditing}"/>
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium"
                                               TextDecorations="{Binding IsCompleted, Converter={x:Static conv:BoolToStrikethroughConverter.Instance}}"/>
                                    <TextBlock Text="{Binding DueDate, StringFormat='due {0:MMM d}'}" Foreground="Gray" IsVisible="{Binding DueDate, Converter={x:Static avconv:ObjectConverters.IsNotNull}}"/>
                                    <TextBlock Text="Overdue" Foreground="{DynamicResource SystemErrorBrush}" FontWeight="Bold" IsVisible="{Binding IsOverdue}"/>
                                </StackPanel>
                                <Button Grid.Row="0" Grid.Column="4" Content="Edit" Background="Transparent" Command="{Binding BeginEditCommand}" IsVisible="{Binding !IsEditing}"/>
                                <Button Grid.Row="0" Grid.Column="5" Content="✕" Background="Transparent" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" IsVisible="{Binding !IsEditing}"/>

                                <!-- Edit mode -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding IsEditing}">
                                    <TextBox Text="{Binding EditTitle}" Width="200"/>
                                    <CalendarDatePicker SelectedDate="{Binding EditDueDate}" Width="140"/>
                                    <ComboBox SelectedIndex="{Binding EditPriority}" Width="100">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Low"/>
                                        <ComboBoxItem Content="Medium"/>
                                        <ComboBoxItem Content="High"/>
                                    </ComboBox>
                                    <Button Content="Save" Command="{Binding CommitEditCommand}"/>
                                    <Button Content="Cancel" Command="{Binding CancelEditCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Custom entries" FontWeight="Bold" FontSize="14"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding NewCustomEntryTitle}" PlaceholderText="Add a custom entry for today…"/>
                <Button Grid.Column="1" Content="Add" Margin="8,0,0,0" Command="{Binding AddCustomEntryCommand}"/>
            </Grid>
            <TextBlock Text="No custom entries yet." Classes="empty-state" IsVisible="{Binding CustomEntries.Count, Converter={x:Static conv:CountToIsEmptyConverter.Instance}}"/>
            <ItemsControl ItemsSource="{Binding CustomEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:CustomEntryItemViewModel">
                        <Border Classes="card" Margin="0,0,0,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding EntryDate, StringFormat='{}{0:MMM d}'}" Foreground="Gray"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕" Background="Transparent" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Other upcoming events" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="Nothing else coming up." Classes="empty-state" IsVisible="{Binding OtherEvents.Count, Converter={x:Static conv:CountToIsEmptyConverter.Instance}}"/>
            <ItemsControl ItemsSource="{Binding OtherEvents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:CalendarListItemViewModel">
                        <Border Classes="card" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding When, StringFormat='{}{0:MMM d, h:mm tt}'}" Foreground="Gray"/>
                                <TextBlock Text="{Binding Detail}" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Other class sessions" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="Nothing outside the weekly grid." Classes="empty-state" IsVisible="{Binding OtherClasses.Count, Converter={x:Static conv:CountToIsEmptyConverter.Instance}}"/>
            <ItemsControl ItemsSource="{Binding OtherClasses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:CalendarListItemViewModel">
                        <Border Classes="card" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding When, StringFormat='{}{0:MMM d, h:mm tt}'}" Foreground="Gray"/>
                                <TextBlock Text="{Binding Detail}" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>

</UserControl>
