<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudentDesktop.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="StudentDesktop.Views.TotpView"
             x:DataType="vm:TotpViewModel">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
        <StackPanel Spacing="10">
            <TextBlock Text="Enter your authentication code" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Open your authenticator app and enter the 6-digit code for this account."
                       TextWrapping="Wrap" Foreground="Gray"/>

            <TextBlock Text="TOTP code"/>
            <TextBox Text="{Binding TotpCode}" PlaceholderText="6-digit code"/>

            <Border Classes="banner-error" IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"/>
            </Border>

            <Button Content="Sign in" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}"/>
            <Button Content="Back" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding BackCommand}" IsEnabled="{Binding !IsBusy}"/>
        </StackPanel>
    </Grid>

</UserControl>
