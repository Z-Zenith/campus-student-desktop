<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudentDesktop.ViewModels"
             xmlns:models="using:StudentDesktop.Models"
             xmlns:webview="using:Avalonia.Controls"
             xmlns:avconv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="StudentDesktop.Views.CodeEditorView"
             x:DataType="vm:CodeEditorViewModel"
             Background="#1E1E1E">

    <!--
      Deliberately styled as its own dark, VS Code-matching surface rather than
      following the app's own (purple-accented) light/dark theme — this tab is meant to
      read as a dedicated professional coding tool, the way VS Code itself doesn't
      re-skin to match whatever else is open on your desktop. Colors here are chosen to
      sit flush against the WebView-hosted editor's own dark theme (see
      code-host-theme.css's [data-theme="dark"] palette) so the native chrome and the
      embedded editor read as one continuous surface, not two different apps stitched
      together.
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="CodeChromeBackground" Color="#252526"/>
        <SolidColorBrush x:Key="CodeChromeBorder" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="CodeChromeText" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="CodeChromeMuted" Color="#969696"/>
        <SolidColorBrush x:Key="CodeAccent" Color="#0E639C"/>
        <SolidColorBrush x:Key="CodeAccentHover" Color="#1177BB"/>
        <SolidColorBrush x:Key="CodeSelected" Color="#37373D"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Slim title strip — no marketing copy eating into the workspace; a real IDE
             doesn't explain itself above the fold every time you open it. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CodeChromeBackground}"
                BorderBrush="{StaticResource CodeChromeBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="14,8" Spacing="8">
                <TextBlock Text="💻" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="Coding" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource CodeChromeText}"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="#F48771" TextWrapping="Wrap"
                   Background="#5A1D1D" Padding="14,8"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static avconv:StringConverters.IsNotNullOrEmpty}}"/>

        <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource CodeChromeBackground}"
                BorderBrush="{StaticResource CodeChromeBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10,12,6">
                    <TextBlock Text="PROJECTS" FontSize="11" FontWeight="Bold" LetterSpacing="1"
                               Foreground="{StaticResource CodeChromeMuted}"/>
                </StackPanel>
                <Button DockPanel.Dock="Top" Content="+ New project" Command="{Binding NewProjectCommand}"
                        Margin="8,0,8,8" Padding="0,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{StaticResource CodeAccent}" Foreground="White" BorderThickness="0" CornerRadius="3">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource CodeAccentHover}"/>
                        </Style>
                    </Button.Styles>
                </Button>
                <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                         Background="Transparent" BorderThickness="0" Padding="4,0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="CornerRadius" Value="3"/>
                            <Setter Property="Margin" Value="0,0,0,1"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource CodeSelected}"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#2A2D2E"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:CodeProjectSummaryDto">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📁" FontSize="12"/>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{StaticResource CodeChromeText}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Background="#1E1E1E">
            <webview:NativeWebView x:Name="EditorWebView"/>
            <TextBlock Text="Loading…" IsVisible="{Binding !IsLoaded}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="#969696"/>
        </Grid>
    </DockPanel>

</UserControl>
