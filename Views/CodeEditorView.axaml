<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudentDesktop.ViewModels"
             xmlns:models="using:StudentDesktop.Models"
             xmlns:webview="using:Avalonia.Controls"
             xmlns:avconv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="StudentDesktop.Views.CodeEditorView"
             x:DataType="vm:CodeEditorViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,12" Spacing="8">
            <TextBlock Text="Coding" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Powered by the Shared Editor Kit's code editor (SEK-01). Write code across multiple files, then Run it — output, errors, and Problems appear in the editor pane."
                       TextWrapping="Wrap" Foreground="Gray"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static avconv:StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <Border DockPanel.Dock="Left" Width="240" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="New project" Command="{Binding NewProjectCommand}"
                        Margin="8" HorizontalAlignment="Stretch"/>
                <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:CodeProjectSummaryDto">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid>
            <webview:NativeWebView x:Name="EditorWebView"/>
            <TextBlock Text="Loading…" IsVisible="{Binding !IsLoaded}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" Foreground="Gray"/>
        </Grid>
    </DockPanel>

</UserControl>
